# Base de datos.
# Desarrollo local: deja "pglite:./.data/db" (Postgres embebido, no necesitas instalar nada).
# Producción: una URL de Postgres, por ejemplo de Neon o Supabase:
#   DATABASE_URL=postgres://usuario:contraseña@host/basededatos?sslmode=require
DATABASE_URL=pglite:./.data/db

# URL pública del sitio (sin / al final). Se usa en correos, Stripe y SEO.
SITE_URL=http://localhost:3000

# Primer administrador (lo crea `npm run db:seed` o `npm run admin:create`).
ADMIN_EMAIL=admin@ban.mx
ADMIN_PASSWORD=cambia-esta-contraseña-larga

# Pagos con Stripe (opcional). Sin estas claves la tienda funciona en "modo demostración".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fotos grandes y videos (opcional): Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
